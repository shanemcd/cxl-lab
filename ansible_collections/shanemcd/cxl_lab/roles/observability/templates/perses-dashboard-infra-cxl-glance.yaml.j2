# CXL at-a-glance dashboard (lab-owned, project
# {{ observability_namespace }}): tier capacity/usage, workload
# attribution, tiering traffic, VM placement. Consumes the
# openshift:node:memory:tier:* / openshift:vm:memory:tier:* recording
# rules from {{ observability_rule_name }}.
#
# Panel grid: 12x8 (half-width, third-height on the 24-column layout).
# The threshold/line-width constants below are presentation choices of
# this dashboard, not lab configuration.
apiVersion: perses.dev/v1alpha2
kind: PersesDashboard
metadata:
  name: infra-cxl-glance
  namespace: {{ observability_namespace }}
spec:
  instanceSelector:
    matchLabels:
{% for key, value in observability_perses_instance_label.items() %}
      {{ key }}: {{ value }}
{% endfor %}
  config:
    display:
      name: Infrastructure / CXL / Glance
    variables:
      - kind: ListVariable
        spec:
          name: node
          display: {name: OCP node}
          allowAllValue: true
          allowMultiple: false
          customAllValue: '.*'
          defaultValue: '$__all'
          plugin:
            kind: PrometheusLabelValuesVariable
            spec:
              labelName: node
              matchers: ['node_memory_tier_memtotal_bytes']
      - kind: ListVariable
        spec:
          name: namespace
          display: {name: VM namespace}
          allowAllValue: true
          allowMultiple: false
          customAllValue: '.*'
          defaultValue: '$__all'
          plugin:
            kind: PrometheusLabelValuesVariable
            spec:
              labelName: namespace
              matchers: ['openshift:vm:memory:tier:bytes{node=~"$node"}']
      - kind: ListVariable
        spec:
          name: vm
          display: {name: VM}
          allowAllValue: true
          allowMultiple: false
          customAllValue: '.*'
          defaultValue: '$__all'
          plugin:
            kind: PrometheusLabelValuesVariable
            spec:
              labelName: vm
              matchers: ['openshift:vm:memory:tier:bytes{node=~"$node", namespace=~"$namespace"}']
      - kind: ListVariable
        spec:
          name: limit
          display: {name: VM chart limit}
          allowAllValue: false
          allowMultiple: false
          defaultValue: '10'
          plugin:
            kind: StaticListVariable
            spec:
              values:
                - {label: '5', value: '5'}
                - {label: '10', value: '10'}
                - {label: '20', value: '20'}
                - {label: '50', value: '50'}
    panels:
      CxlTierUsed:
        kind: Panel
        spec:
          display:
            name: Node memory used, by tier
            description: >-
              Used memory on the selected nodes: tier 0 is CPU-attached
              DRAM; tier 1 is the emulated CXL region. Emulation does not
              reproduce physical CXL latency. Node panels respond only
              to OCP node; VM namespace and VM filter the VM panels.
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
              visual:
                areaOpacity: 1
                display: line
                lineWidth: 0.25  # hardcode-ok: chart line weight, presentation only
                stack: all
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      sum by (node, tier) (
                        openshift:node:memory:tier:bytes{scope="node", utilized="true", node=~"$node"}
                      )
                    seriesNameFormat: '{{ "{{node}} · tier {{tier}}" }}'
      CxlTierUtilization:
        kind: Panel
        spec:
          display:
            name: Tier utilization ratio
            description: >-
              Used / capacity per tier per node. DRAM tiers run hot by
              design; the CXL tier should stay low until the
              tier-descheduler or memory pressure demotes cold pages onto
              it. Answers: is the CXL tier actually being used, and is
              DRAM under pressure?
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: decimal
                min: 0
                max: 1
                show: true
              thresholds:
                steps:
                  - value: 0.85  # hardcode-ok: presentation thresholds, not lab config
                  - color: '#FF9F1C'
                    value: 0.95  # hardcode-ok: presentation threshold
                  - color: '#EA4747'
                    value: 0.99  # hardcode-ok: presentation threshold
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: openshift:node:memory:tier:utilization:ratio{node=~"$node"}
                    seriesNameFormat: '{{ "{{node}} · tier {{tier}}" }}'
      CxlWorkloadsByTier:
        kind: Panel
        spec:
          display:
            name: Workload anonymous memory, by tier
            description: >-
              Anonymous (working-set) memory attributed to workloads per
              tier via per-cgroup NUMA accounting. Movement from tier 0
              to tier 1 is kernel demotion — what the memory-tiering demo
              is about. Answers: how much workload memory has been
              demoted onto CXL?
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
              visual:
                areaOpacity: 1
                display: line
                lineWidth: 0.25  # hardcode-ok: chart line weight, presentation only
                stack: all
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      sum by (tier) (
                        openshift:node:memory:tier:bytes{scope="workloads", utilized="true", node=~"$node"}
                      )
                    seriesNameFormat: '{{ "tier {{tier}}" }}'
      CxlTieringTraffic:
        kind: Panel
        spec:
          display:
            name: Tiering traffic — demote into / promote out of CXL
            description: >-
              Kernel page demotion (kswapd/khugepaged/direct reclaim
              moving pages to slower tiers — into CXL) and promotion (hot
              pages pulled back to DRAM), from per-node vmstat
              pgdemote/pgpromote counters. Answers: is the tiering
              machinery moving pages right now?
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum (openshift:node:memory:tier:demote:rate{node=~"$node"})
                    seriesNameFormat: demote
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: sum (openshift:node:memory:tier:promote:rate{node=~"$node"})
                    seriesNameFormat: promote
      CxlVMPlacement:
        kind: Panel
        spec:
          display:
            name: VM memory placement by tier
            description: >-
              Anonymous resident memory in VM launcher cgroups, including
              QEMU overhead, not configured guest RAM. Explicit HugeTLB
              guest RAM is excluded. Node, namespace and VM selectors
              apply. The largest N VM/node pairs at the range end are
              held fixed across the chart, with both tiers preserved.
              Migration may show the same VM on two nodes. Lines are
              unstacked so a large DRAM series cannot hide CXL.
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
              visual:
                areaOpacity: 0
                display: line
                lineWidth: 1.5  # hardcode-ok: chart line weight, presentation only
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      sum by (node, namespace, vm, tier) (
                        openshift:vm:memory:tier:bytes{node=~"$node", namespace=~"$namespace", vm=~"$vm"}
                      ) and on (node, namespace, vm)
                      topk($limit, sum by (node, namespace, vm) (
                        openshift:vm:memory:tier:bytes{node=~"$node", namespace=~"$namespace", vm=~"$vm"} @ end()
                      ))
                    seriesNameFormat: '{{ "{{namespace}}/{{vm}} · {{node}} · tier {{tier}}" }}'
      CxlVMCxlResidency:
        kind: Panel
        spec:
          display:
            name: VM residency on CXL tier
            description: >-
              Launcher-cgroup anonymous memory on CXL (tier 1), including
              QEMU overhead, excluding explicit HugeTLB memory. Shows the
              top N VM/node pairs by CXL residency at the range end, after
              applying node, namespace and VM filters. Its separate scale
              keeps MiB of CXL visible alongside GiB of DRAM.
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
              visual:
                areaOpacity: 0.25
                display: line
                lineWidth: 1.5  # hardcode-ok: chart line weight, presentation only
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      sum by (node, namespace, vm) (
                        openshift:vm:memory:tier:bytes{tier="1", node=~"$node", namespace=~"$namespace", vm=~"$vm"}
                      ) and on (node, namespace, vm)
                      topk($limit, sum by (node, namespace, vm) (
                        openshift:vm:memory:tier:bytes{tier="1", node=~"$node", namespace=~"$namespace", vm=~"$vm"} @ end()
                      ))
                    seriesNameFormat: '{{ "{{namespace}}/{{vm}} · {{node}} on CXL" }}'
      CxlTierFree:
        kind: Panel
        spec:
          display:
            name: CXL tier — used vs free
            description: >-
              The emulated CXL region (System RAM on the CPU-less NUMA
              node of the CXL worker) as used + free. Total height is the
              region size; utilization near 0% means nothing has been
              demoted or placed there yet. Answers: how much of the CXL
              region is consumed?
          plugin:
            kind: TimeSeriesChart
            spec:
              legend:
                position: bottom
              yAxis:
                format:
                  unit: bytes
                min: 0
                show: true
              visual:
                areaOpacity: 1
                display: line
                lineWidth: 0.25  # hardcode-ok: chart line weight, presentation only
                stack: all
          queries:
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      openshift:node:memory:tier:bytes{tier="1", scope="node", node=~"$node",
                      utilized="true"}
                    seriesNameFormat: '{{ "{{node}} used" }}'
            - kind: TimeSeriesQuery
              spec:
                plugin:
                  kind: PrometheusTimeSeriesQuery
                  spec:
                    query: >-
                      openshift:node:memory:tier:bytes{tier="1", scope="node", node=~"$node",
                      utilized="false"}
                    seriesNameFormat: '{{ "{{node}} free" }}'
    layouts:
      - kind: Grid
        spec:
          display:
            title: At a Glance - CXL Memory Tier
            collapse:
              open: true
          items:
            - x: 0
              "y": 0
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlTierUsed'
            - x: 12
              "y": 0
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlTierUtilization'
            - x: 0
              "y": 8
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlWorkloadsByTier'
            - x: 12
              "y": 8
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlTieringTraffic'
            - x: 0
              "y": 16
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlVMPlacement'
            - x: 12
              "y": 16
              width: 12
              height: 8
              content:
                $ref: '#/spec/panels/CxlTierFree'
            - x: 0
              "y": 24
              width: 24
              height: 8
              content:
                $ref: '#/spec/panels/CxlVMCxlResidency'
    duration: 1h
    refreshInterval: 15s
