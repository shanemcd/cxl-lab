#!/usr/bin/env python3
# Managed by shanemcd.cxl_lab.vms — do not edit.
# Pre-baked race guard: probe the MCS-served {{ mco_cxl_mcp_name }} pool
# config and exit 0 only when its rendered /etc/containers/registries.conf
# carries the insecure-registry entry for the lab registry. The workers'
# firstboot pivot pulls the layered image over plain HTTP; a worker that
# fetches a pre-trust render retries its rebase against untrusted HTTPS
# forever without re-fetching (observed live).
import base64
import json
import ssl
import sys
import urllib.request

MCS_CONFIG_URL = "{{ vms_mcs_pool_config_url }}"
REGISTRY_HOST = "{{ registry_host }}"

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

try:
    with urllib.request.urlopen(MCS_CONFIG_URL, timeout=10, context=ctx) as resp:
        ignition = json.load(resp)
except Exception:
    sys.exit(1)

trusted = False
for f in ignition.get("storage", {}).get("files", []):
    if f.get("path") == "/etc/containers/registries.conf":
        src = f.get("contents", {}).get("source", "")
        body = base64.b64decode(src.split(",", 1)[1]).decode() if "," in src else ""
        if "insecure = true" in body and REGISTRY_HOST in body:
            trusted = True

sys.exit(0 if trusted else 1)
