#!/usr/bin/env bash
# Managed by cxl-lab. libvirt is the only VM lifecycle owner.
# Compatibility interface for the lab's region/verify/ops playbooks.
set -euo pipefail
export LC_ALL=C
name={{ node.name | quote }}
uri={{ libvirt_uri | quote }}
virsh_cmd=(virsh -c "$uri")
if [ "${1:-start}" != --status ]; then
  exec 9>{{ (vm_run_dir ~ '/' ~ node.name ~ '.lifecycle.lock') | quote }}
  flock 9
fi
if ! domain_uuid=$("${virsh_cmd[@]}" domuuid "$name" 2>/dev/null); then
  # Distinguish an absent definition from an unreachable libvirt service.
  "${virsh_cmd[@]}" list --all --name >/dev/null
  case "${1:-start}" in --status) exit 3;; --stop) exit 0;; *) exit 1;; esac
fi
if [ "$domain_uuid" != {{ node.name | to_uuid | quote }} ]; then
  echo "refusing to manage an unrelated same-name domain" >&2
  exit 1
fi
state() { "${virsh_cmd[@]}" domstate "$name" 2>/dev/null | head -1; }
is_up() { case "$(state)" in running|paused|'in shutdown') return 0;; *) return 1;; esac; }
case "${1:-start}" in
  --status)
    if is_up; then echo "$name: $(state)"; exit 0; fi
    echo "$name: stopped"; exit 3
    ;;
  --stop)
    if is_up; then
      "${virsh_cmd[@]}" shutdown "$name"
      for ((i=0; i<{{ vm_stop_wait_seconds | int }}; i++)); do
        is_up || exit 0
        sleep 1
      done
      "${virsh_cmd[@]}" destroy "$name"
    fi
    ;;
  --validate)
    # Starting paused validates the complete libvirt/QEMU graph and opens
    # the real disks, without executing guest instructions. Never disturb
    # a running domain. Preserve the historical success return code.
    if is_up; then exit 124; fi
    "${virsh_cmd[@]}" start "$name" --paused
    trap '"${virsh_cmd[@]}" destroy "$name" >/dev/null' EXIT
    exit 124
    ;;
  start)
    if [ "$(state)" = paused ]; then
      "${virsh_cmd[@]}" resume "$name"
      echo "$name started, pid managed by libvirt"
    elif is_up; then
      echo "$name already running"
    else
      "${virsh_cmd[@]}" start "$name"
      echo "$name started, pid managed by libvirt"
    fi
    ;;
  *) echo 'usage: --status | --stop | --validate | start' >&2; exit 2;;
esac
