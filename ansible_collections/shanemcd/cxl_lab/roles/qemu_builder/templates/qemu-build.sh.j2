#!/usr/bin/env bash
# Managed by cxl_lab.lab.qemu_builder — do not edit (plan §4).
# Builds stock upstream QEMU {{ qemu_version }} (NO patch — the v1 DVSEC patch
# was proven a no-op) inside the CS10 builder container and installs it to a
# DESTDIR staging tree; the role copies the staged tree to the host prefix.
# CS10's glibc matches the RHEL 10 host, so the binary runs on the host.
set -euo pipefail

cd {{ qemu_builder_workspace_mount }}

echo "==> installing build dependencies (CS10 BaseOS/AppStream/CRB)"
dnf -y --enablerepo crb install {{ qemu_builder_build_deps | join(' ') }}
dnf clean all

echo "==> extracting the QEMU source tarball"
tar -xf "{{ qemu_source_url | basename }}"
cd "qemu-{{ qemu_version }}"

echo "==> configuring (x86_64-softmmu, prefix {{ qemu_install_prefix }})"
./configure --target-list=x86_64-softmmu --prefix={{ qemu_install_prefix }}

echo "==> building"
ninja -C build

echo "==> installing to the staging tree"
DESTDIR={{ qemu_builder_workspace_mount }}/{{ qemu_builder_staging_dir | basename }} ninja -C build install

echo "==> qemu build OK"
