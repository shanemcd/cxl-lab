# Managed by cxl_lab.lab.network — do not edit (plan §10.8).
# Host-native lab resolver on the bridge gateway: DNS-only (no DHCP — node
# addressing is static via ignition-baked NM keyfiles). Serves the cluster
# records (the same names as the host /etc/hosts block) plus node FQDNs,
# and forwards everything else to the upstream resolvers. Required because
# ignition fetches config.merge sources before applying storage: worker
# stubs must resolve api-int at initramfs fetch time with only the NM
# keyfile resolver (the MCS cert has DNS SANs only — no IP-URL rewrite).
listen-address={{ lab_gateway_ip }}
bind-interfaces
no-resolv
no-hosts
no-poll
cache-size=150

# DHCP with per-MAC reservations (plan §10.8 addendum): initramfs
# networking is default-DHCP and ignition applies the static NM keyfiles
# only after the fetch phase — workers need a lease to fetch their MCS
# config. Reservations pin every node to its taxonomy IP, so first-boot
# DHCP and the later static keyfiles agree. The free range is asserted
# collision-free against gateway/probe/node suffixes by the network role.
dhcp-range={{ lab_subnet_prefix }}.{{ network_dhcp_range_start_suffix }},{{ lab_subnet_prefix }}.{{ network_dhcp_range_end_suffix }},{{ lab_subnet_netmask }},12h
dhcp-option=6,{{ lab_gateway_ip }}
{% for node in masters + cxl_workers + dram_workers %}
dhcp-host={{ mac_base }}:{{ node.mac_suffix }},{{ lab_subnet_prefix }}.{{ node.ip_suffix }}
{% endfor %}

# Cluster records (same shape as the host /etc/hosts block).
{% for line in network_hosts_block %}
{% set parts = line.split() %}
host-record={{ parts[1:] | join(',') }},{{ parts[0] }}
{% endfor %}

# Node FQDNs (static addressing, single source of truth = node suffixes).
{% for node in masters + cxl_workers + dram_workers %}
host-record={{ node.name }}.{{ lab_domain }},{{ lab_subnet_prefix }}.{{ node.ip_suffix }}
{% endfor %}

# Upstream forwarders (internet names).
{% for server in upstream_dns_servers %}
server={{ server }}
{% endfor %}
