set -eu
SZ={{ verify_touch_size_mib }}
NODE={{ cxl_guest_numa_node }}
# Probe node placement directly from numa_maps: an anonymous mapping
# under membind reports its exact per-node residency. A node MemUsed
# delta is not a usable signal here — freed pages cycle through the
# per-cpu allocator caches without re-crossing the zone accounting,
# so back-to-back runs measure deltas of the full blob, zero, then
# noise (observed live on identical input). Read-back is checked
# twice against the written pattern for data integrity.
numactl --membind=${NODE} python3 - "${SZ}" "${NODE}" <<'PY'
import ctypes
import hashlib
import mmap
import re
import sys

size_mib, node = int(sys.argv[1]), sys.argv[2]
size = size_mib * 1024 * 1024
pattern = bytes(range(256)) * (size // 256)
expect = hashlib.md5(pattern).hexdigest()
buf = mmap.mmap(-1, size)
buf.write(pattern)
buf.seek(0)
first = hashlib.md5(buf.read(size)).hexdigest()
buf.seek(0)
second = hashlib.md5(buf.read(size)).hexdigest()
addr = ctypes.addressof(ctypes.c_char.from_buffer(buf))
# numa_maps lines start with the bare mapping address — no 0x prefix
pages = 0
for line in open("/proc/self/numa_maps"):
    if line.startswith(format(addr, "x")):
        m = re.search(r"(?:^|\s)N%s=(\d+)" % node, line)
        pages = int(m.group(1)) if m else 0
        break
print("TOUCH_NODE1_KIB=%d" % (pages * 4))
print("TOUCH_MD5_OK=%s"
      % ("yes" if first == second == expect else "no"))
PY
