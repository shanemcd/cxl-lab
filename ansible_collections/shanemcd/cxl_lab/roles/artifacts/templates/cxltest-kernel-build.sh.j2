#!/usr/bin/env bash
# Managed by cxl_lab.lab.artifacts — do not edit.
# Builds the cxltest kernel RPMs from the RHEL SRPM inside the disposable
# CentOS Stream 10 builder container (runbook §0 artifacts; experiment log
# 2026-10-09 recipe: config flip only, vendor config otherwise preserved,
# baseonly, unsigned eln-style build, {{ kernel_rpm_buildid }} buildid).
set -euo pipefail

RPMS_DIR="{{ artifacts_kernel_rpms_dir }}"
BUILD_TAG="{{ kernel_rpm_buildid }}"
JOBS={{ artifacts_kernel_builder_jobs }}

echo "==> installing SRPM"
rpm -ivh --quiet "{{ artifacts_srpm_dir }}/{{ kernel_srpm_nvr }}.src.rpm"

echo "==> installing build dependencies (CS10 BaseOS/AppStream/CRB)"
dnf -y install cpio
dnf -y builddep --enablerepo crb /root/rpmbuild/SPECS/kernel.spec

echo "==> flipping test-only kernel config in place (vendor config preserved otherwise)"
CFG=/root/rpmbuild/SOURCES/kernel-x86_64-rhel.config
if grep -q '^CONFIG_CXL_REGION_INVALIDATION_TEST=y$' "${CFG}"; then
  echo "already flipped"
elif grep -q '^# CONFIG_CXL_REGION_INVALIDATION_TEST is not set$' "${CFG}"; then
  sed -i 's/^# CONFIG_CXL_REGION_INVALIDATION_TEST is not set$/CONFIG_CXL_REGION_INVALIDATION_TEST=y/' "${CFG}"
else
  echo "FAIL: CONFIG_CXL_REGION_INVALIDATION_TEST not found in vendor config" >&2
  exit 1
fi

echo "==> building kernel RPMs (baseonly, unsigned eln-style, ${JOBS} jobs)"
rpmbuild -bb --with baseonly \
  --define "buildid .${BUILD_TAG}" \
  --define "eln 1" \
  --define "_smp_mflags -j${JOBS}" \
  /root/rpmbuild/SPECS/kernel.spec

echo "==> collecting RPMs"
mkdir -p "${RPMS_DIR}"
cp /root/rpmbuild/RPMS/x86_64/*.rpm "${RPMS_DIR}/"

echo "==> cxltest kernel build OK"
