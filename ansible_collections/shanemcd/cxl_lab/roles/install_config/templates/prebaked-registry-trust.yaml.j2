# Managed by shanemcd.cxl_lab.install_config — do not edit.
# Pre-baked path: the workers' firstboot pivot pulls the layered image from
# the lab registry over plain HTTP, and the MCS renders each worker's
# registries.conf from this object — so the trust must exist BEFORE the
# first worker fetches its config. Shipping it as an install-time manifest
# lets the CVO apply it during bootstrap. (The MCO path patches the same
# object post-install instead; see the mco_cxl role.)
apiVersion: config.openshift.io/v1
kind: Image
metadata:
  name: cluster
spec:
  registrySources:
    insecureRegistries:
      - {{ registry_host }}
