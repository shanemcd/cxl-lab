# Managed by shanemcd.cxl_lab.install_config — do not edit.
# Secrets are injected via facts slurped by privileged tasks (controller-side
# file lookups cannot read the root-owned 0600 files); rendering runs no_log.
apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ cluster_name }}
compute:
- name: worker
  replicas: {{ upi_compute_replicas | int }}
controlPlane:
  name: master
  replicas: {{ masters | length }}
platform:
  none: {}
bootstrapInPlace:
  installationDisk: {{ bip_installation_disk }}
pullSecret: {{ install_config_pull_secret_json | to_json }}
sshKey: {{ install_config_ssh_pubkey | to_json }}
networking:
  networkType: {{ cluster_network_type }}
  machineNetwork:
  - cidr: {{ lab_subnet_cidr }}
  clusterNetwork:
  - cidr: {{ cluster_network_cidr }}
    hostPrefix: {{ cluster_network_host_prefix | int }}
  serviceNetwork:
  - {{ service_network_cidr }}
fips: {{ cluster_fips | bool | ternary('true', 'false') }}
featureSet: {{ install_feature_set }}
osImageStream: {{ rhcos_stream_name }}
