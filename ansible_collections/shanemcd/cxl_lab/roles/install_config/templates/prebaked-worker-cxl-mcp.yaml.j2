# Managed by shanemcd.cxl_lab.install_config — do not edit.
# Install-time worker-cxl MachineConfigPool. Created before bootstrap so
# its rendered config (which the pre-baked CXL workers fetch at
# /config/worker-cxl on their FIRST boot) already carries the layered
# osImageURL. Selector In [worker, worker-cxl] so the pool inherits every
# worker MachineConfig and its config is complete.
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfigPool
metadata:
  name: {{ worker_cxl_mcp_name }}
spec:
  machineConfigSelector:
    matchExpressions:
      - key: machineconfiguration.openshift.io/role
        operator: In
        values:
          - worker
          - {{ worker_cxl_role_label }}
  nodeSelector:
    matchLabels:
      node-role.kubernetes.io/{{ worker_cxl_role_label }}: ""
