# Managed by shanemcd.cxl_lab.install_config — do not edit.
# Install-time osImageURL MachineConfig for the worker-cxl role. The MCD's
# firstboot OS check compares the node's booted image ref against this
# string; setting it to the layered image's local ref (the exact ref a
# BIB-booted worker reports as booted) makes the check match, so no pivot,
# pull, or reboot ever fires and the cxltest kernel the worker booted from
# the pre-baked disk stays.
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  labels:
    machineconfiguration.openshift.io/role: {{ worker_cxl_role_label }}
  name: {{ worker_cxl_osimage_mc_name }}
spec:
  osImageURL: {{ layered_image_local_ref }}
